{
  "name": "@lihaozhe013/pi-web",
  "version": "0.12.2",
  "description": "Minimal web GUI for the Pi coding agent",
  "homepage": "https://github.com/lihaozhe013/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihaozhe013/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/lihaozhe013/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "node node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 30141",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 30141",
    "start:lan": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 30141",
    "lint": "node node_modules/oxlint/bin/oxlint .",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "package:portable": "node packaging/portable.mjs",
    "test:portable": "node --test packaging/portable.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "js-yaml": "^5.5.0",
    "next": "16.4.3",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "7.8.5",
    "undici": "8.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "oxlint": "^1.89",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "typescript5": "npm:typescript@5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp"
  ]
}
