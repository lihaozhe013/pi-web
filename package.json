{
  "name": "@lihaozhe013/pie",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Minimal GUI for the Pi coding agent",
  "homepage": "https://github.com/lihaozhe013/pie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihaozhe013/pie.git"
  },
  "bugs": {
    "url": "https://github.com/lihaozhe013/pie/issues"
  },
  "license": "MIT",
  "browserslist": [
    "chrome >= 130"
  ],
  "bin": {
    "pie": "bin/pie.js"
  },
  "files": [
    "bin",
    "build/server",
    "dist",
    "package.json",
    "lib/ask-user-labels.ts",
    "lib/ask-user-extension.ts",
    "lib/ask-user-presentation.ts"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "build": "node scripts/generate-routes.mjs && node node_modules/vite/bin/vite.js build && node node_modules/vite/bin/vite.js build --config vite.server.config.mts",
    "start": "node bin/pie.js start",
    "start:local": "node bin/pie.js start -H 127.0.0.1 -p 8966",
    "start:lan": "node bin/pie.js start -H 0.0.0.0 -p 8966",
    "format": "node node_modules/prettier/bin/prettier.cjs . --write",
    "lint": "node node_modules/oxlint/bin/oxlint .",
    "package:portable": "node packaging/portable.mjs",
    "desktop:dev": "node packaging/desktop.mjs --dev",
    "desktop:build": "node packaging/desktop.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "js-yaml": "^5.5.0",
    "pi-better-goal": "^0.10.4",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "7.8.5",
    "typebox": "1.3.27",
    "undici": "8.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "ansi_up": "^6.0.6",
    "jiti": "^2.7.0",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "oxc-parser": "^0.155.0",
    "oxlint": "^1.89",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^8.3.5"
  },
  "overrides": {
    "rehype-katex>katex": "$katex"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs",
    "sharp"
  ]
}
